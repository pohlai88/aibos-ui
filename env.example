# AI-BOS ERP Environment Configuration
# Copy this file to .env.local and update with your values

# Application
NODE_ENV=development
PORT=3000
API_PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=aibos_erp

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Multi-tenancy
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Redis (for caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# External Services
NEXT_TELEMETRY_DISABLED=1

# Development
LOG_LEVEL=debug
ENABLE_SWAGGER=true

# Turbo Configuration
TURBO_CONCURRENCY=4

# Node.js Memory Configuration
# Increase if you get out-of-memory errors during builds
NODE_OPTIONS=--max_old_space_size=8192

# Development Server Ports
# Pin ports to avoid clashes when running multiple dev servers
WEB_PORT=3000
API_PORT=4000
ADMIN_PORT=4001

# File Watcher Limits (Linux/WSL)
# If you get ENOSPC errors, increase these limits:
# echo fs.inotify.max_user_watches=524288 | sudo tee -a /etc/sysctl.conf
# echo fs.inotify.max_user_instances=1024 | sudo tee -a /etc/sysctl.conf
# sudo sysctl -p

# Open File Limits (macOS/Linux)
# If you get EMFILE errors, increase file descriptor limit:
# ulimit -n 65536
# macOS persistent: sudo launchctl limit maxfiles 65536 200000