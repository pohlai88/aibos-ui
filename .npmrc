# === Monorepo Safety Guard: prefer pnpm, harden installs ===

# Fail if engines in package.json don't match
engine-strict=true

# npm-specific: never create package-lock.json
package-lock=false

# Security/telemetry
audit=true
audit-level=moderate
fund=false

# Registry (keep default or point to your proxy)
registry=https://registry.npmjs.org/

# pnpm settings (pnpm reads .npmrc too)
strict-peer-dependencies=false
auto-install-peers=true
workspace-concurrency=4
prefer-workspace-packages=true
