{
  "name": "aibos-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.mjs",
    "build": "turbo run build --cache-dir=.turbo",
    "build:types": "turbo run build:types --log-order=stream",
    "build:tsc": "tsc -p tsconfig.build.json",
    "typecheck:all": "turbo run typecheck --no-cache",
    "check:all": "pnpm -r typecheck && pnpm -r lint && pnpm lint:arch",
    "check:ui-dependencies": "node scripts/check-ui-dependencies.js",
    "ci": "turbo run format lint typecheck test dep:check build --no-daemon --log-order=stream",
    "clean": "powershell -Command \"if (Test-Path 'dist') { Remove-Item -Recurse -Force 'dist' }; if (Test-Path '.turbo') { Remove-Item -Recurse -Force '.turbo' }; if (Test-Path '.next') { Remove-Item -Recurse -Force '.next' }; if (Test-Path 'tsconfig.tsbuildinfo') { Remove-Item -Force 'tsconfig.tsbuildinfo' }; if (Test-Path 'node_modules') { Remove-Item -Recurse -Force 'node_modules' }\" && pnpm store prune || echo 'Store prune completed with warnings'",
    "db:migrate": "cd apps/bff && pnpm run typeorm migration:run",
    "db:seed": "cd apps/bff && pnpm run typeorm migration:run && node -e \"require('./dist/seeds/development.seed.js').seedDevelopmentData(require('typeorm').DataSource)\"",
    "debug": "node scripts/debug.js",
    "debug:quick": "node scripts/debug.js --quick",
    "dep:check": "npx depcruise --validate --config .dependency-cruiser.js --include-only \"^(apps|packages|services)/\" --output-type text apps packages",
    "dep:graph": "npx depcruise --config .dependency-cruiser.js --include-only \"^(apps|packages|services)/\" --output-type dot apps packages | dot -T svg > dep-graph.svg",
    "dev": "cross-env TURBO_CONCURRENCY=4 turbo run dev --no-cache",
    "dev:apps": "cross-env TURBO_CONCURRENCY=3 turbo run dev --filter=./apps/* --no-cache",
    "dev:bff": "cross-env TURBO_CONCURRENCY=4 turbo run dev --filter=@aibos/bff --no-daemon",
    "dev:high": "cross-env TURBO_CONCURRENCY=6 turbo run dev --no-cache",
    "dev:low": "cross-env TURBO_CONCURRENCY=2 turbo run dev --no-cache",
    "dev:packages": "cross-env TURBO_CONCURRENCY=8 turbo run dev --filter='@aibos/*' --filter='!@aibos/web' --filter='!@aibos/bff' --no-daemon",
    "dev:web": "cross-env TURBO_CONCURRENCY=4 turbo run dev --filter=@aibos/web --no-daemon",
    "dev:web+api": "cross-env TURBO_CONCURRENCY=2 turbo run dev --filter=@aibos/web --filter=@aibos/bff --no-cache",
    "dx": "turbo run format lint typecheck test dep:check --log-order=stream && pnpm syncpack:check",
    "dx:full": "pnpm dx && pnpm lint:arch",
    "dx:config": "pnpm syncpack:check && pnpm lint --max-warnings=0",
    "dx:build": "pnpm build:tsc && pnpm build",
    "dx:quick": "pnpm syncpack:check",
    "dx:validate": "pnpm syncpack:check && pnpm lint --max-warnings=0",
    "dx:format": "pnpm format && pnpm syncpack:check",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "generate:docs": "node scripts/generate-ui-ecosystem-docs.js",
    "generate:graphs": "node scripts/generate-dependency-graph.js",
    "lint": "eslint .",
    "lint:arch": "dependency-cruiser --config .dependency-cruiser.js apps packages",
    "lint:arch:graph": "dependency-cruiser --config .dependency-cruiser.js --output-type dot apps packages | dot -T svg > dependency-graph.svg",
    "lint:fix": "eslint . --fix",
    "json:validate": "node ./scripts/json-validate.mjs",
    "json:generate": "node ./scripts/jsonc-to-json.mjs",
    "safe:scan": "node ./scripts/safe-scan.mjs",
    "safe:fix": "node ./scripts/safe-fix.mjs",
    "open:docs": "tsx scripts/open-ui-ecosystem-documentation.ts",
    "prepare": "simple-git-hooks",
    "setup:db": "node scripts/setup-database.js",
    "syncpack:check": "syncpack list-mismatches",
    "syncpack:fix": "syncpack fix-mismatches",
    "syncpack:lint": "syncpack lint-semver-ranges",
    "test": "pnpm -r --filter \"@aibos/*\" test",
    "test:repo": "vitest run packages/accounting/src/**/__tests__/*.spec.ts",
    "test:repo:watch": "vitest watch packages/accounting/src/**/__tests__/*.spec.ts",
    "test:watch": "pnpm -r --filter \"@aibos/*\" test:watch",
    "test:coverage": "pnpm -r test --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:performance": "k6 run tests/performance/smoke-test.js",
    "tsc:solution": "tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "validate:all": "pnpm validate:comprehensive",
    "validate:comprehensive": "node scripts/validate-ui-ecosystem-only.js",
    "validate:dependencies": "node scripts/validate-dependencies.js",
    "validate:ui-ecosystem": "node scripts/validate-ui-ecosystem.js",
    "verify:structure": "node scripts/verify-structure.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm run dx"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "*.{md,json,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@swc/helpers": "^0.5.17",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.6",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "cross-env": "^10.0.0",
    "dependency-cruiser": "^17.0.1",
    "escape-string-regexp": "^5.0.0",
    "eslint": "9.36.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsonc": "^2.20.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^3.0.5",
    "fast-glob": "^3.3.3",
    "jsonc-eslint-parser": "^2.4.1",
    "jsonc-parser": "^3.2.1",
    "knip": "^5.64.1",
    "lint-staged": "^16.2.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "syncpack": "^13.0.4",
    "ts-morph": "^27.0.0",
    "ts-node": "^10.9.2",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.6",
    "turbo": "^2.5.8",
    "typescript": "5.9.2",
    "vitest": "^2.1.9",
    "zod": "^3.23.8",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "sqlite3": "^5.1.7",
    "better-sqlite3": "^9.4.3",
    "drizzle-orm": "^0.33.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.18.0",
    "npm": "DISALLOWED",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.12.2",
      "esbuild": "0.25.0",
      "marked": "4.0.10",
      "postcss": "8.4.31"
    }
  }
}
