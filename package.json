{
  "name": "aibos-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure UI component library SDK - React components with Tailwind CSS",
  "scripts": {
    "preinstall": "node ./scripts/enforce-pnpm.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b",
    "build": "turbo run build --filter=@aibos/ui",
    "test": "turbo run test --filter=@aibos/ui",
    "clean": "turbo run clean && rimraf node_modules .turbo packages/*/dist packages/*/.tsbuildinfo",
    "dev": "turbo run dev --filter=@aibos/ui",
    "format": "prettier --cache --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run build",
    "dev:full": "concurrently \"pnpm run dev\" \"pnpm run test:watch\" \"pnpm run typecheck:watch\"",
    "test:watch": "turbo run test:watch --filter=@aibos/ui",
    "test:coverage": "turbo run test:coverage --filter=@aibos/ui",
    "test:ui": "turbo run test:ui --filter=@aibos/ui",
    "typecheck:watch": "turbo run typecheck:watch --filter=@aibos/ui",
    "size": "turbo run size --filter=@aibos/ui",
    "analyze": "turbo run analyze --filter=@aibos/ui"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged",
    "pre-push": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=5 --fix"
    ],
    "*.{md,json,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "concurrently": "^8.2.2",
    "eslint": "9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-tailwindcss": "3.17.0",
    "lint-staged": "^16.2.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rimraf": "^6.0.1",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.5.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.18.0",
    "npm": "DISALLOWED",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.4.31"
    }
  }
}
