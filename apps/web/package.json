{
  "name": "@aibos/web",
  "version": "0.1.0",
  "private": true,
  "sideEffects": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "clean": "rimraf .next",
    "dep:check": "depcruise --validate --config ../../.dependency-cruiser.js --output-type text src",
    "dev": "next dev",
    "format": "prettier -w .",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "next:check": "node ./scripts/next-health-check.mjs",
    "test": "echo 'No tests yet'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run next:check"
  },
  "dependencies": {
    "@aibos/accounting": "workspace:*",
    "@aibos/accounting-contracts": "workspace:*",
    "@aibos/accounting-web": "workspace:*",
    "@aibos/contracts": "workspace:*",
    "@aibos/ui": "workspace:*",
    "@aibos/utils": "workspace:*",
    "@headlessui/react": "1.7.0",
    "@hookform/resolvers": "3.9.1",
    "@tanstack/react-query": "5.90.2",
    "@tanstack/react-query-devtools": "5.90.2",
    "@tanstack/react-table": "8.21.3",
    "@types/d3": "7.4.0",
    "@types/lodash": "4.17.20",
    "lucide-react": "0.400.0",
    "next": "15.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.53.2",
    "recharts": "2.8.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.0.0",
    "@types/node": "22.18.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "autoprefixer": "10.4.0",
    "jest": "29.0.0",
    "jest-environment-jsdom": "29.0.0",
    "postcss": "8.4.31",
    "tailwindcss": "3.4.0",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
