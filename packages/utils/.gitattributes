# AIBOS Utils Package Protection
# =============================

# Prevent accidental modifications to critical files
src/index.ts -text
src/security.ts -text
src/safe-object.ts -text
src/safeFs.ts -text
src/type-guards.ts -text
src/code-quality.ts -text
package.json -text
tsconfig.json -text
tsup.config.ts -text
.lockfile -text

# Ensure line endings are consistent
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.map binary
*.cjs binary
