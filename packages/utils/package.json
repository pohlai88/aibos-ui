{
  "name": "@aibos/utils",
  "version": "0.1.0",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./code-quality": {
      "types": "./dist/types/src/code-quality.d.ts",
      "import": "./dist/code-quality.js",
      "require": "./dist/code-quality.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.types.json",
    "build:js": "tsup",
    "build": "pnpm run build:types && pnpm run build:js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "escape-string-regexp": "5.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/react": "18.2.0",
    "@typescript-eslint/eslint-plugin": "8.44.1",
    "@typescript-eslint/parser": "8.44.1",
    "eslint": "9.36.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-sonarjs": "3.0.5",
    "prettier": "3.6.2",
    "react": "18.2.0",
    "tsup": "8.5.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "react": "18.2.0"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
