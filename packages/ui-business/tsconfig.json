{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node", "react", "react-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/components/*": ["src/accounting/components/*"],
      "@/hooks/*": ["src/accounting/hooks/*"],
      "@/services/*": ["src/accounting/services/*"],
      "@/types/*": ["src/accounting/types/*"],
      "@/utils/*": ["src/accounting/utils/*"],
      "@/constants/*": ["src/accounting/constants/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx"],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/accounting"
    }
  ]
}
