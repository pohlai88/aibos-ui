{
  "name": "@aibos/ui",
  "version": "0.1.0",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/src/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs",
      "default": "./dist/core.js"
    },
    "./tokens": {
      "types": "./dist/types/src/tokens/index.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs",
      "default": "./dist/tokens.js"
    },
    "./primitives/*": {
      "types": "./dist/types/src/primitives/*.d.ts",
      "import": "./dist/primitives/*.js",
      "require": "./dist/primitives/*.cjs",
      "default": "./dist/primitives/*.js"
    },
    "./components/*": {
      "types": "./dist/types/src/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    },
    "./utils": {
      "types": "./dist/types/src/utils/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs",
      "default": "./dist/utils.js"
    },
    "./performance": {
      "types": "./dist/types/src/performance/index.d.ts",
      "import": "./dist/src/performance.js",
      "require": "./dist/src/performance.cjs",
      "default": "./dist/src/performance.js"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/utilities.css": "./src/styles/utilities.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "analyze:bundle": "tsx src/scripts/analyze-bundle.ts",
    "build": "pnpm run lock:check && pnpm run build:types && pnpm run build:js",
    "build:js": "pnpm run lock:check && tsup",
    "build:types": "pnpm run lock:check && tsc -p tsconfig.types.json",
    "check:ui-dependencies": "cd ../.. && npx depcruise --config .dependency-cruiser.js packages/ui/src",
    "convert:aliases": "tsx src/scripts/convert-to-aliases.ts",
    "dashboard": "open src/performance/dashboard.html",
    "guard:imports": "node src/scripts/guard-imports.mjs src",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lock:check": "node scripts/lock-guard.js check",
    "lock:init": "node scripts/lock-guard.js init",
    "lock:status": "node scripts/lock-guard.js status",
    "lock:update-hashes": "node scripts/lock-guard.js update-hashes",
    "scan:components": "tsx src/scripts/scan-components.ts",
    "test": "vitest run",
    "test:a11y:axe": "vitest run src/test/a11y/axe.smoke.test.tsx",
    "test:a11y:contrast": "vitest run src/test/a11y/contrast.smoke.test.tsx",
    "test:a11y:contrast:diff": "tsx src/test/a11y/contrast-diff.util.ts",
    "test:a11y:contrast:snapshot": "vitest run src/test/a11y/contrast.snapshot.test.tsx",
    "test:a11y:contrast:snapshot:out": "CONTRAST_SNAPSHOT_PATH=.artifacts/contrast-snapshot.json vitest run src/test/a11y/contrast.snapshot.test.tsx",
    "test:analyze": "node src/test/test-report/test-analyzer.js",
    "test:coverage": "vitest run --coverage",
    "test:dashboard": "node src/test/test-report/test-runner.js",
    "test:dashboard:architecture": "start src/test/test-report/pages/architecture-detailed.html",
    "test:dashboard:components": "start src/test/test-report/pages/component-previews.html",
    "test:dashboard:open": "start src/test/test-report/index.html",
    "test:dashboard:performance": "start src/test/test-report/pages/performance-analytics.html",
    "test:perf:diff": "tsx src/test/perf-diff.util.ts",
    "test:perf:snapshot": "vitest run src/test/perf.snapshot.test.tsx",
    "test:perf:snapshot:out": "PERF_SNAPSHOT_PATH=.artifacts/perf-snapshot.json vitest run src/test/perf.snapshot.test.tsx",
    "test:performance": "vitest run --reporter=verbose src/test/performance",
    "test:playwright": "playwright test",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:ui": "playwright test --ui",
    "test:report": "pnpm test && pnpm test:dashboard",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "validate": "pnpm lint && pnpm typecheck && pnpm typecheck:scripts && pnpm test",
    "validate:full": "pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm test:a11y",
    "validate:usage-map": "node src/scripts/validate-usage-map.mjs docs/usage-map.json",
    "validate:usage-map:ci": "node src/scripts/validate-usage-map.mjs --sarif docs/usage-map.json > docs/usage-map.sarif"
  },
  "dependencies": {
    "@aibos/utils": "workspace:*",
    "@hookform/resolvers": "3.9.1",
    "@testing-library/react": "16.3.0",
    "@radix-ui/react-accordion": "1.1.2",
    "@radix-ui/react-checkbox": "1.0.4",
    "@radix-ui/react-dialog": "1.0.5",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-menu": "2.0.6",
    "@radix-ui/react-popover": "1.0.7",
    "@radix-ui/react-portal": "1.1.9",
    "@radix-ui/react-radio-group": "1.1.3",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.0.3",
    "@radix-ui/react-tabs": "1.0.4",
    "@radix-ui/react-toast": "1.1.5",
    "@radix-ui/react-tooltip": "1.0.7",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "lucide-react": "0.400.0",
    "react-hook-form": "7.53.2",
    "tailwind-merge": "2.6.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@swc/core": "1.13.19",
    "@swc/helpers": "0.5.17",
    "@tailwindcss/container-queries": "0.1.0",
    "@tailwindcss/forms": "0.5.0",
    "@tailwindcss/line-clamp": "0.4.4",
    "@tailwindcss/typography": "0.5.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/user-event": "14.0.0",
    "@types/jest-axe": "3.5.9",
    "@types/node": "22.18.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "5.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "ajv-keywords": "5.1.0",
    "autoprefixer": "10.4.0",
    "axe-core": "4.9.0",
    "eslint": "9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-tailwindcss": "3.17.0",
    "fast-glob": "3.3.3",
    "glob": "11.0.0",
    "globals": "16.4.0",
    "jest-axe": "10.0.0",
    "json-source-map": "0.6.1",
    "postcss": "8.4.31",
    "prettier": "3.6.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "size-limit": "11.0.0",
    "tailwindcss": "3.4.0",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "5.4.20",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9"
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB"
    },
    {
      "path": "dist/index.cjs",
      "limit": "50 KB"
    }
  ]
}
