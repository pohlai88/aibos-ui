{
  "name": "aibos-ui",
  "version": "0.1.1",
  "private": false,
  "sideEffects": false,
  "type": "module",
  "description": "Pure UI component library SDK - React components with Tailwind CSS, TypeScript, and accessibility",
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "typescript",
    "accessibility",
    "design-system",
    "sdk"
  ],
  "author": "AI-BOS Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pohlai88/aibos-ui.git"
  },
  "homepage": "https://github.com/pohlai88/aibos-ui#readme",
  "bugs": {
    "url": "https://github.com/pohlai88/aibos-ui/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/types/src/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs",
      "default": "./dist/core.js"
    },
    "./tokens": {
      "types": "./dist/types/src/tokens/index.d.ts",
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.cjs",
      "default": "./dist/tokens.js"
    },
    "./primitives/*": {
      "types": "./dist/types/src/primitives/*.d.ts",
      "import": "./dist/primitives/*.js",
      "require": "./dist/primitives/*.cjs",
      "default": "./dist/primitives/*.js"
    },
    "./components/*": {
      "types": "./dist/types/src/components/*.d.ts",
      "import": "./dist/components/*.js",
      "require": "./dist/components/*.cjs",
      "default": "./dist/components/*.js"
    },
    "./utils": {
      "types": "./dist/types/src/utils/index.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs",
      "default": "./dist/utils.js"
    },
    "./performance": {
      "types": "./dist/types/src/performance/index.d.ts",
      "import": "./dist/src/performance.js",
      "require": "./dist/src/performance.cjs",
      "default": "./dist/src/performance.js"
    },
    "./styles/globals.css": "./src/styles/globals.css",
    "./styles/utilities.css": "./src/styles/utilities.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "types": "./dist/types/src/index.d.ts",
  "files": [
    "dist",
    "src/styles",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:js",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.types.json",
    "build:watch": "tsup --watch",
    "dev": "tsup --watch",
    "dev:tsup": "tsup --watch",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:staged": "eslint --max-warnings 0",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=verbose",
    "test:ci": "vitest run --coverage --reporter=json --outputFile=test-results.json",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "clean": "rimraf dist coverage .turbo",
    "prepublishOnly": "pnpm run validate && pnpm run build",
    "size": "node scripts/check-bundle-budgets.mjs",
    "analyze": "pnpm run build && pnpm run size",
    "build:ci": "pnpm run build && pnpm run size",
    "docs:generate": "typedoc",
    "docs:serve": "pnpm run docs:generate && npx serve docs/api",
    "docs:build": "pnpm run docs:generate && pnpm run build:ci",
    "deploy:docs": "pnpm run docs:build && pnpm run deploy:production"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-accordion": "1.1.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "1.0.4",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "1.0.5",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-menu": "2.0.6",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "1.0.7",
    "@radix-ui/react-portal": "1.1.9",
    "@radix-ui/react-radio-group": "1.1.3",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "2.0.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "1.2.3",
    "@radix-ui/react-switch": "1.0.3",
    "@radix-ui/react-tabs": "1.0.4",
    "@radix-ui/react-toast": "1.1.5",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "1.0.7",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.13.12",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "react-hook-form": "7.53.2",
    "tailwind-merge": "2.6.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.2",
    "@axe-core/react": "^4.10.2",
    "@swc/core": "1.13.19",
    "@swc/helpers": "0.5.17",
    "@tailwindcss/container-queries": "0.1.0",
    "@tailwindcss/forms": "0.5.0",
    "@tailwindcss/line-clamp": "0.4.4",
    "@tailwindcss/typography": "0.5.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.0.0",
    "@types/node": "22.18.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "5.0.3",
    "@vitest/coverage-v8": "2.1.9",
    "@vitest/ui": "2.1.9",
    "autoprefixer": "10.4.0",
    "axe-core": "^4.10.3",
    "eslint": "9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-tailwindcss": "3.17.0",
    "globals": "16.4.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^27.0.0",
    "postcss": "8.4.31",
    "prettier": "3.6.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "rimraf": "6.0.1",
    "tailwindcss": "3.4.0",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "typedoc": "0.25.12",
    "typescript": "5.9.2",
    "vite": "5.4.20",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "2.1.9"
  },
  "peerDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
