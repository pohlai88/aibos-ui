{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aibos-erp.com/schemas/usage-map.json",
  "title": "AIBOS UI Usage Map",
  "description": "Schema for tracking component usage across ERP pages and stories",
  "type": "object",
  "additionalProperties": false,
  "$comment": "LINT: This is the SSOT for UI usage mapping. Keep it small, declarative, and consistent. Avoid ad-hoc fields—extend definitions instead.",
  "required": ["$schemaVersion", "componentDefaults", "components"],
  "properties": {
    "$schemaVersion": {
      "type": "string",
      "const": "1.1",
      "$comment": "LINT: Bump only when breaking changes are introduced to the schema."
    },
    "componentDefaults": {
      "type": "object",
      "$comment": "INFO: Global defaults become authoring rails. When in doubt, mirror these in each component.",
      "additionalProperties": false,
      "required": ["requiredTags", "requiredStories", "standardSuites"],
      "properties": {
        "requiredTags": {
          "type": "array",
          "$comment": "LINT: Every component.tags MUST include all of these. CI can enforce as superset.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["a11y", "kbd", "dark", "rtl", "reducedMotion", "perf"]
          }
        },
        "requiredStories": {
          "type": "array",
          "$comment": "LINT: Every component.stories MUST include all of these. Think of this as the minimum contract.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "standardSuites": {
          "type": "object",
          "$comment": "GUIDE: Suites are curated bundles reviewers look for in PRs: core basics, states, layout, content, perf, a11y.",
          "additionalProperties": false,
          "properties": {
            "core": {
              "type": "array",
              "$comment": "SUGGEST: Include: Default, Focus, KeyboardNav, Disabled, Loading",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "states": {
              "type": "array",
              "$comment": "SUGGEST: Error, Success, ReadOnly, WithValidation",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "layout": {
              "type": "array",
              "$comment": "SUGGEST: WithHeader, WithFooter, WithActions, Responsive",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "content": {
              "type": "array",
              "$comment": "SUGGEST: WithIcon, WithPrefixSuffix, Truncation, Wrap",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "perf": {
              "type": "array",
              "$comment": "SUGGEST: Virtualized, Skeleton, LoadingSkeleton",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "a11y": {
              "type": "array",
              "$comment": "SUGGEST: AriaLabelling, AriaErrors, ContrastCheck",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "meta": {
              "type": "array",
              "$comment": "SUGGEST: Dark, RTL, ReducedMotion",
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "components": {
      "type": "object",
      "$comment": "LINT: Keys must be PascalCase component names (e.g., Button, DataTable, Dialog).",
      "additionalProperties": false,
      "patternProperties": {
        "^[A-Z][a-zA-Z0-9]*$": {
          "$ref": "#/definitions/component"
        }
      }
    },
    "hooks": {
      "type": "object",
      "$comment": "LINT: Keys must be React hook names starting with use*.",
      "additionalProperties": false,
      "patternProperties": {
        "^use[A-Z][a-zA-Z0-9]*$": {
          "$ref": "#/definitions/hook"
        }
      }
    },
    "icons": {
      "type": "object",
      "$comment": "GUIDE: Icons are grouped by source: 'internal' and 'lucide'.",
      "additionalProperties": false,
      "properties": {
        "internal": {
          "$ref": "#/definitions/iconGroup"
        },
        "lucide": {
          "$ref": "#/definitions/iconGroup"
        }
      }
    },
    "utils": {
      "type": "object",
      "$comment": "GUIDE: Utility entries are single-purpose helpers used across components.",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]*$": {
          "$ref": "#/definitions/utility"
        }
      }
    },
    "tokens": {
      "type": "object",
      "$comment": "GUIDE: Token groups should reflect semantic contracts (color, radius, shadow, spacing, typography, etc.).",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]*$": {
          "$ref": "#/definitions/tokenGroup"
        }
      }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "$comment": "REVIEW: A production-ready component should be status='ready', stories cover core+a11y suites, and tags meet requiredTags.",
      "additionalProperties": false,
      "required": ["owner", "priority", "status", "pages", "stories", "description", "tags"],
      "properties": {
        "owner": {
          "type": "string",
          "enum": ["ui-team", "design-system", "platform-team"],
          "$comment": "GUIDE: Choose the accountable maintainer team."
        },
        "priority": {
          "type": "string",
          "enum": ["p0", "p1", "p2", "p3"],
          "$comment": "GUIDE: p0=critical path / must-not-break; p3=nice-to-have."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "wip", "ready", "deprecated"],
          "$comment": "LINT: If 'deprecated', link migration notes in description (or future 'meta.deprecationNote')."
        },
        "risk": {
          "type": "array",
          "$comment": "GUIDE: Tag known risk surfaces to focus reviews and tests.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "focus-visible",
              "contrast",
              "validation",
              "focus-trap",
              "aria-labelling",
              "scroll-lock",
              "virtualization",
              "keyboard-nav",
              "aria-roles",
              "aria-errors",
              "async-validation"
            ]
          }
        },
        "contracts": {
          "type": "object",
          "$comment": "GUIDE: Declare which tokens/variants the component consumes—this is your SSOT link to design.",
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "array",
              "$comment": "LINT: Only list semantic contracts (e.g., spacing, shadow). Avoid raw values here.",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "semantic.color",
                  "spacing",
                  "radius",
                  "shadow",
                  "border",
                  "typography",
                  "z-index"
                ]
              }
            },
            "variants": {
              "type": "array",
              "$comment": "GUIDE: Only declare public variants (documented in stories).",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "intent",
                  "size",
                  "tone",
                  "state",
                  "type",
                  "layout",
                  "validation",
                  "density",
                  "striped",
                  "orientation"
                ]
              }
            }
          }
        },
        "pages": {
          "type": "array",
          "$comment": "LINT: Use absolute ERP routes starting with '/'. Prefer product-level pages over stories.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "stories": {
          "type": "array",
          "$comment": "LINT: Must include componentDefaults.requiredStories; avoid duplicates; prefer small, purposeful stories.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Default",
              "Focus",
              "KeyboardNav",
              "Disabled",
              "Loading",
              "Error",
              "Success",
              "ReadOnly",
              "WithIcon",
              "WithPrefixSuffix",
              "Truncation",
              "Wrap",
              "WithHeader",
              "WithFooter",
              "WithActions",
              "CustomContent",
              "Skeleton",
              "Virtualized",
              "AriaLabelling",
              "ContrastCheck",
              "Gallery",
              "Dark",
              "RTL",
              "ReducedMotion",
              "IconOnly",
              "Ghost",
              "Link",
              "PasswordWithToggle",
              "FocusTrap",
              "InitialFocus",
              "ScrollLock",
              "CloseOnEscape",
              "EmptyState",
              "ErrorRetry",
              "LoadingSkeleton",
              "StickyHeader",
              "ResizableColumns",
              "RowSelectionKbd",
              "AriaErrors",
              "SubmitLoading",
              "AsyncSubmit",
              "MultiStepKbd",
              "WithValidation",
              "WithFileUpload",
              "Overflow",
              "Responsive",
              "WithIcons"
            ]
          }
        },
        "description": {
          "type": "string",
          "$comment": "GUIDE: Explain what this component solves. If deprecated, include migration guidance.",
          "minLength": 10
        },
        "tags": {
          "type": "array",
          "$comment": "LINT: Must be a superset of componentDefaults.requiredTags for parity in testing and docs.",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["a11y", "kbd", "dark", "rtl", "reducedMotion", "perf"]
          }
        }
      }
    },
    "hook": {
      "type": "object",
      "$comment": "GUIDE: Hooks document where they're used and have a minimal story to demo behaviour.",
      "additionalProperties": false,
      "required": ["pages", "stories", "description"],
      "properties": {
        "pages": {
          "type": "array",
          "$comment": "LINT: Use absolute ERP routes. Avoid deep wildcards.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "stories": {
          "type": "array",
          "$comment": "GUIDE: Keep short, functional demos (e.g., Default, Error, Loading).",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "description": {
          "type": "string",
          "$comment": "GUIDE: Describe behaviour, inputs, and side-effects.",
          "minLength": 10
        }
      }
    },
    "iconGroup": {
      "type": "object",
      "$comment": "GUIDE: Give consumers examples of icon usage patterns per page type.",
      "additionalProperties": false,
      "required": ["pages", "stories", "description"],
      "properties": {
        "pages": {
          "type": "array",
          "$comment": "GUIDE: Where these icons are typically used.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "stories": {
          "type": "array",
          "$comment": "GUIDE: Show size, state, and contrast variations.",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "description": {
          "type": "string",
          "$comment": "GUIDE: Document sourcing rules and theming notes.",
          "minLength": 10
        }
      }
    },
    "utility": {
      "type": "object",
      "$comment": "GUIDE: Utilities should be stable, small, and well-documented.",
      "additionalProperties": false,
      "required": ["pages", "stories", "description"],
      "properties": {
        "pages": {
          "type": "array",
          "$comment": "GUIDE: Where this utility is currently relied upon.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "stories": {
          "type": "array",
          "$comment": "GUIDE: Provide at least one minimal usage story.",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "description": {
          "type": "string",
          "$comment": "GUIDE: What problem does this utility solve?",
          "minLength": 10
        }
      }
    },
    "tokenGroup": {
      "type": "object",
      "$comment": "GUIDE: Token groups are platform contracts. Changing them is a breaking change—version intentionally.",
      "additionalProperties": false,
      "required": ["pages", "stories", "description"],
      "properties": {
        "owner": {
          "type": "string",
          "enum": ["design-system", "ui-team"],
          "$comment": "GUIDE: Who governs this token group?"
        },
        "priority": {
          "type": "string",
          "enum": ["p0", "p1", "p2", "p3"],
          "$comment": "GUIDE: p0 tokens affect critical rendering paths."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "wip", "ready", "deprecated"],
          "$comment": "LINT: Deprecated tokens must include migration notes in description."
        },
        "risk": {
          "type": "array",
          "$comment": "GUIDE: Call out theming/contrast/perf hazards for reviewers.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["contrast", "theming", "performance"]
          }
        },
        "contracts": {
          "type": "object",
          "$comment": "GUIDE: Which component contracts are impacted by this token group.",
          "additionalProperties": false,
          "properties": {
            "tokens": {
              "type": "array",
              "$comment": "GUIDE: Reference token facets, not raw values.",
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "variants": {
              "type": "array",
              "$comment": "GUIDE: Which public variants are shaped by these tokens.",
              "uniqueItems": true,
              "items": { "type": "string" }
            }
          }
        },
        "pages": {
          "type": "array",
          "$comment": "GUIDE: Representative pages to validate token effects.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/"
          }
        },
        "stories": {
          "type": "array",
          "$comment": "GUIDE: Minimal stories to demo token application and theme switching.",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "description": {
          "type": "string",
          "$comment": "GUIDE: Purpose, theme interactions, and migration guidance.",
          "minLength": 10
        },
        "tags": {
          "type": "array",
          "$comment": "GUIDE: Tag token groups for quick a11y/perf audit filters.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["a11y", "dark", "rtl", "reducedMotion", "perf"]
          }
        }
      }
    }
  }
}
