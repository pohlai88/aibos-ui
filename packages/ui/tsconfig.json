{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "baseUrl": ".",
    "paths": {
      "@icons/internal": ["./src/icons/internal"],
      "@icons/internal/*": ["./src/icons/internal/*"],
      "@icons/lucide": ["./src/icons/lucide"],
      "@radix/accordion": ["./src/radix/accordion"],
      "@radix/checkbox": ["./src/radix/checkbox"],
      "@radix/dialog": ["./src/radix/dialog"],
      "@primitives/dialog": ["./src/radix/dialog"],
      "@radix/menu": ["./src/radix/menu"],
      "@radix/popover": ["./src/radix/popover"],
      "@radix/radio": ["./src/radix/radio"],
      "@radix/select": ["./src/radix/select"],
      "@radix/slot": ["./src/radix/slot"],
      "@radix/switch": ["./src/radix/switch"],
      "@radix/tabs": ["./src/radix/tabs"],
      "@radix/toast": ["./src/radix/toast"],
      "@radix/tooltip": ["./src/radix/tooltip"],
      "@primitives/button": ["./src/primitives/button"],
      "@primitives/loading-spinner": ["./src/primitives/loading-spinner"],
      "@primitives/input": ["./src/primitives/input"],
      "@primitives/checkbox": ["./src/primitives/checkbox"],
      "@primitives/radio": ["./src/primitives/radio"],
      "@primitives/switch": ["./src/primitives/switch"],
      "@primitives/badge": ["./src/primitives/badge"],
      "@components/card": ["./src/components/card"],
      "@components/modal": ["./src/components/modal"],
      "@components/table": ["./src/components/table"],
      "@components/form": ["./src/components/form"],
      "@components/navigation": ["./src/components/navigation"],
      "@components/popover": ["./src/components/popover"],
      "@components/select": ["./src/components/select"],
      "@components/tooltip": ["./src/components/tooltip"],
      "@components/toast": ["./src/components/toast"],
      "@components/tabs": ["./src/components/tabs"],
      "@components/accordion": ["./src/components/accordion"],
      "@components/breadcrumb": ["./src/components/breadcrumb"],
      "@components/pagination": ["./src/components/pagination"],
      "@components/error-boundary": ["./src/components/error-boundary"],
      "@components/loading-button": ["./src/components/loading-button"],
      "@components/async-loading": ["./src/components/async-loading"],
      "@components/skeleton-table": ["./src/components/skeleton-table"],
      "@components/virtual-table": ["./src/components/virtual-table"],
      "@hooks/use-theme": ["./src/hooks/use-theme"],
      "@hooks/use-media-query": ["./src/hooks/use-media-query"],
      "@hooks/use-correlation": ["./src/hooks/use-correlation"],
      "@hooks/use-toast": ["./src/hooks/use-toast"],
      "@examples/playground": ["./src/examples/playground"],
      "@tokens": ["./src/tokens"]
    }
  },
  "include": [
    "src",
    "test",
    "tests",
    "**/*.test.*",
    "**/*.spec.*",
    "**/*.config.*",
    "vitest.config.ts",
    "tsup.config.ts"
  ],
  "exclude": ["dist", "node_modules", ".next"]
}
