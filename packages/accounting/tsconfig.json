{
  "extends": "../../tsconfig.base.json",
  "references": [
    { "path": "../eventsourcing" }
  ],
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "tsBuildInfoFile": ".tsbuildinfo",
    "baseUrl": ".",
    "paths": {
      "@aibos/eventsourcing": ["../eventsourcing/dist/types/src/index.d.ts"]
    },
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/__tests__/**",
    "dist",
    "node_modules",
    ".next"
  ]
}
