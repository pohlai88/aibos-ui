{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts", 
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/utils/**/*.spec.ts",
    "src/utils/**/*.test.ts",
    "src/utils/__tests__/**/*"
  ]
}
